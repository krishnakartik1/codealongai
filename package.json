{
  "name": "codealongai",
  "displayName": "CodeAlongAI",
  "description": "A model-free hackathon prototype for collaborating with an AI companion in the editor.",
  "version": "0.0.1",
  "publisher": "krishnakartik1",
  "private": true,
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onCommand:codealongai.askPair",
    "onCommand:codealongai.prototype.comments.start"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codealongai.askPair",
        "title": "CodeAlongAI: Ask pair"
      },
      {
        "command": "codealongai.replay.advance",
        "title": "CodeAlongAI: Continue walkthrough"
      },
      {
        "command": "codealongai.follow.breakAway",
        "title": "CodeAlongAI: Stop following"
      },
      {
        "command": "codealongai.replay.reset",
        "title": "CodeAlongAI: Reset walkthrough"
      },
      {
        "command": "codealongai.proposal.reject",
        "title": "CodeAlongAI: Reject staged proposal"
      },
      {
        "command": "codealongai.proposal.cancel",
        "title": "CodeAlongAI: Cancel staged proposal"
      },
      {
        "command": "codealongai.proposal.requestAcceptance",
        "title": "CodeAlongAI: Request proposal acceptance"
      },
      {
        "command": "codealongai.prototype.comments.start",
        "title": "CodeAlongAI Prototype: Start native Comment walkthrough"
      },
      {
        "command": "codealongai.prototype.comments.back",
        "title": "Back",
        "icon": "$(arrow-left)"
      },
      {
        "command": "codealongai.prototype.comments.next",
        "title": "Next",
        "icon": "$(arrow-right)"
      },
      {
        "command": "codealongai.prototype.comments.destinations",
        "title": "Destinations",
        "icon": "$(list-tree)"
      },
      {
        "command": "codealongai.prototype.comments.reply",
        "title": "Ask CodeAlongAI",
        "icon": "$(send)"
      },
      {
        "command": "codealongai.prototype.comments.showState",
        "title": "CodeAlongAI Prototype: Show prototype state"
      },
      {
        "command": "codealongai.prototype.comments.reset",
        "title": "CodeAlongAI Prototype: Reset native Comment walkthrough"
      }
    ],
    "menus": {
      "comments/commentThread/title": [
        {
          "command": "codealongai.prototype.comments.back",
          "when": "commentController == codealongai.prototype.nativeComments && commentThread =~ /hasBack/",
          "group": "inline@1"
        },
        {
          "command": "codealongai.prototype.comments.next",
          "when": "commentController == codealongai.prototype.nativeComments && commentThread =~ /hasNext/",
          "group": "inline@2"
        },
        {
          "command": "codealongai.prototype.comments.destinations",
          "when": "commentController == codealongai.prototype.nativeComments && commentThread =~ /hasDestinations/",
          "group": "inline@3"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "codealongai.prototype.comments.reply",
          "when": "commentController == codealongai.prototype.nativeComments",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "codealongai.prototype.comments.back",
          "when": "false"
        },
        {
          "command": "codealongai.prototype.comments.next",
          "when": "false"
        },
        {
          "command": "codealongai.prototype.comments.destinations",
          "when": "false"
        },
        {
          "command": "codealongai.prototype.comments.reply",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vscode-test",
    "test:headless": "npm run build && xvfb-run -a vscode-test",
    "prototype:comments": "npm run build && code --new-window --extensionDevelopmentPath=. demo-workspace"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.18.3",
    "@types/vscode": "^1.103.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "typescript": "^5.9.2"
  }
}
